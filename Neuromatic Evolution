class Neuromatic7DEngine:
    def __init__(self):
        # Neural weights representing synaptic pathways between dimensions
        # Initialized to random biological baselines
        self.synaptic_weights = [random.uniform(0.8, 1.2) for _ in range(7)]
        # Track historical structural strain for neuroplastic adaptation
        self.plasticity_index = 1.0
        self.cellular_fatigue = 0.0

    def neuromorphic_activation(self, value, weight):
        """Simulates a biological axon potential using a weighted tanh activation function."""
        stimulated_input = value * weight
        # Tanh clamps raw coordinate values between -1.0 and 1.0, mimicking a neural saturation curve
        return math.tanh(stimulated_input)

    def compute_neuromatic_field(self, vector_7d):
        if len(vector_7d) != 7:
            raise ValueError("Input must be an absolute 7-dimensional coordinate tuple.")
        
        t1, t2, t3, x, y, z, u = vector_7d
        
        # --- 1. Neuromatic Time Scaling (Axonal Propagation) ---
        # t1 Quantum: Fast micro-firing rates
        quantum_firing = self.neuromorphic_activation(t1 * 10, self.synaptic_weights[0])
        # t2 Interaction: Synaptic cleft mediation (Neurotransmitter depletion model)
        synaptic_mediation = 1.0 / (1.0 + math.exp(-t2 * self.synaptic_weights[1]))
        # t3 Cosmological: Deep neural oscillation wave (Theta/Delta wave simulation)
        deep_brain_oscillation = math.cos(t3) * self.synaptic_weights[2] * (1.0 - self.cellular_fatigue)

        # --- 2. Neuromatic Mass Scaling (Dendritic Clusters) ---
        # Treating spatial points as neural density clusters
        m1_dendrite = abs(self.neuromorphic_activation(x, self.synaptic_weights[3])) * 15.0
        m2_axon_hillock = abs(self.neuromorphic_activation(y, self.synaptic_weights[4])) * 22.0
        m3_myelin_sheath = abs(self.neuromorphic_activation(z, self.synaptic_weights[5])) * 38.0
        
        total_neural_mass = m1_dendrite + m2_axon_hillock + m3_myelin_sheath
        neurological_stress = total_neural_mass * (1.0 + abs(deep_brain_oscillation))

        # --- 3. Neuroplastic Adaptation Loops ---
        # If stress is nominal, synaptic pathway weights grow stronger (LTP - Long-Term Potentiation)
        # If stress is excessively high, pathways undergo synaptic fatigue/depression
        if neurological_stress > 50.0:
            self.cellular_fatigue = min(self.cellular_fatigue + 0.05, 0.9)  # Fatigue builds up
            self.plasticity_index *= 0.95  # Synaptic depression
            # High stress causes axon pruning (weights decay)
            self.synaptic_weights = [w * 0.98 for w in self.synaptic_weights]
            adaptation_state = "SYNAPTIC_FATIGUE"
        else:
            self.cellular_fatigue = max(self.cellular_fatigue - 0.02, 0.0)  # Recharging neurotransmitters
            if abs(deep_brain_oscillation) > 0.5:
                self.plasticity_index = min(self.plasticity_index + 0.02, 3.0)  # Hebbian learning boost
                self.synaptic_weights = [min(w * 1.01, 2.5) for w in self.synaptic_weights]
                adaptation_state = "LONG_TERM_POTENTIATION (LTP)"
            else:
                adaptation_state = "NEURAL_HOMEOSTASIS"

        # Check for neurological seizure/collapse threshold
        is_collapsed = False
        collapse_reason = ""
        if u == 0.0:
            is_collapsed = True
            collapse_reason = "Universal Master Core Neuronal flatline."
        elif self.cellular_fatigue >= 0.85:
            is_collapsed = True
            collapse_reason = "Neurotransmitter Exhaustion. The network collapsed into an unresponsive refractory state."
        elif neurological_stress > 80.0:
            is_collapsed = True
            collapse_reason = f"Neurological Stress ({neurological_stress:.2f} Hz) exceeded Seizure Threshold (80.0 Hz)."

        return {
            "is_collapsed": is_collapsed,
            "collapse_reason": collapse_reason,
            "total_mass": total_neural_mass,
            "stress": neurological_stress,
            "adaptation_state": adaptation_state,
            "net_efficiency": (1.0 - self.cellular_fatigue) * self.plasticity_index,
            "components": {
                "quantum_firing": quantum_firing,
                "synaptic_mediation": synaptic_mediation,
                "deep_oscillation": deep_brain_oscillation
            }
        }

    def process_neuromatic_payload(self, vector_7d, payload):
        metrics = self.compute_neuromatic_field(vector_7d)
        
        if metrics["is_collapsed"]:
            # Auto-rehabilitate the model neural synapses back to health on failure
            self.synaptic_weights = [random.uniform(0.9, 1.1) for _ in range(7)]
            self.cellular_fatigue = 0.0
            self.plasticity_index = 1.0
            return {"status": "COLLAPSED", "message": metrics["collapse_reason"]}
            
        net_shift = metrics["net_efficiency"] * u_factor_calculation(vector_7d[6], metrics["stress"])
        
        return {
            "status": "SUCCESS",
            "metrics": metrics,
            "net_shift": net_shift,
            "transformed_payload": f"Neural_Matrix_Decoded_Via_Factor_{net_shift:.4f}"
        }

def u_factor_calculation(u, stress):
    return u * (1.0 / (stress + 0.1))

