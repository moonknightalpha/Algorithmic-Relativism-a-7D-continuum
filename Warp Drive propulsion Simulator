        self.emitter_efficiencies = [1.0 for _ in range(7)]
        self.field_harmonic_index = 1.0
        self.coil_thermal_strain = 0.0

    def calculate_field_saturation(self, value, efficiency):
        """Simulates localized spacetime metric saturation using a strict physics clamping limit."""
        field_input = value * efficiency
        # Clamps extreme inputs to simulate the physical limit of spacetime structural compression
        return math.tanh(field_input)

    def compute_propulsion_metrics(self, vector_7d):
        if len(vector_7d) != 7:
            raise ValueError("Input must be an absolute 7-dimensional warp vector tuple.")
        
        t1, t2, t3, x, y, z, u = vector_7d
        
        # --- 1. Spacetime Distortion Scaling (Temporal Filters) ---
        # t1: Quantum Sub-Planckian Casimir field fluctuations
        quantum_casimir_flux = self.calculate_field_saturation(t1 * 10, self.emitter_efficiencies[0])
        # t2: Mesoscopic Field Mediation (The bridge coupling quantum voids to macro-space)
        mesoscopic_coupling = 1.0 / (1.0 + math.exp(-t2 * self.emitter_efficiencies[1]))
        # t3: Cosmological Metric Ripple (High-frequency gravitational wave generation)
        gravitational_wave_ripple = math.cos(t3) * self.emitter_efficiencies[2] * (1.0 - self.coil_thermal_strain)

        # --- 2. Plasma Shell Vectoring (Exotic Mass Particles) ---
        # Treating spatial coordinates as rotating mass ring arrays around the vessel
        m1_quantum_plasma = abs(self.calculate_field_saturation(x, self.emitter_efficiencies[3])) * 15.0
        m2_baryon_plasma  = abs(self.calculate_field_saturation(y, self.emitter_efficiencies[4])) * 22.0
        m3_dark_matter_plasma = abs(self.calculate_field_saturation(z, self.emitter_efficiencies[5])) * 38.0
        
        total_plasma_mass_load = m1_quantum_plasma + m2_baryon_plasma + m3_dark_matter_plasma
        gravitational_shear_stress = total_plasma_mass_load * (1.0 + abs(gravitational_wave_ripple))

        # --- 3. Warp Coil Thermal & Distortion Feedback Loops ---
        # If stress climbs past threshold limits, coils absorb heat and warp field efficiency decays
        if gravitational_shear_stress > 50.0:
            self.coil_thermal_strain = min(self.coil_thermal_strain + 0.05, 0.9)  # Accumulate thermal load
            self.field_harmonic_index *= 0.95  # Metric distortion de-sync
            self.emitter_efficiencies = [eff * 0.98 for eff in self.emitter_efficiencies]  # Core degradation
            propulsion_state = "THERMAL_COIL_STRAIN"
        else:
            self.coil_thermal_strain = max(self.coil_thermal_strain - 0.02, 0.0)  # Active coolant dispersion
            if abs(gravitational_wave_ripple) > 0.5:
                self.field_harmonic_index = min(self.field_harmonic_index + 0.02, 3.0)  # Metric lock achieved
                self.emitter_efficiencies = [min(eff * 1.01, 2.5) for eff in self.emitter_efficiencies]
                propulsion_state = "METRIC_REINFORCEMENT (FWM)"
            else:
                propulsion_state = "PROPULSION_HOMEOSTASIS"

        # Check for catastrophic warp field structural breakdown
        is_collapsed = False
        collapse_reason = ""
        if u == 0.0:
            is_collapsed = True
            collapse_reason = "Core containment breach. Main antimatter catalyst voltage flatlined."
        elif self.coil_thermal_strain >= 0.85:
            is_collapsed = True
            collapse_reason = "Thermal warp coil meltdown. Magnetic containment field emergency venting forced sub-light drop."
        elif gravitational_shear_stress > 80.0:
            is_collapsed = True
            collapse_reason = f"Gravitational tidal shear ({gravitational_shear_stress:.2f} G-Units) ruptured the warp envelope boundary (80.0 Limit)."

        return {
            "is_collapsed": is_collapsed,
            "collapse_reason": collapse_reason,
            "total_mass_load": total_plasma_mass_load,
            "shear_stress": gravitational_shear_stress,
            "propulsion_state": propulsion_state,
            "net_engine_efficiency": (1.0 - self.coil_thermal_strain) * self.field_harmonic_index,
            "components": {
                "quantum_casimir": quantum_casimir_flux,
                "mesoscopic_coupling": mesoscopic_coupling,
                "grav_wave_ripple": gravitational_wave_ripple
            }
        }

    def process_propulsion_envelope(self, vector_7d, payload):
        metrics = self.compute_propulsion_metrics(vector_7d)
        u_val = vector_7d[6]
        
        if metrics["is_collapsed"]:
            # Emergency automated subsystem flush on field failure
            self.emitter_efficiencies = [1.0 for _ in range(7)]
            self.coil_thermal_strain = 0.0
            self.field_harmonic_index = 1.0
            return {"status": "COLLAPSED", "message": metrics["collapse_reason"]}
            
        warp_velocity_factor = metrics["net_engine_efficiency"] * (u_val * (1.0 / (metrics["shear_stress"] + 0.1)))
        
        return {
            "status": "SUCCESS",
            "metrics": metrics,
            "warp_velocity_factor": warp_velocity_factor,
            "transformed_payload": f"Warp_Bubble_Telemetry_Locked_At_v_factor_{warp_velocity_factor:.4f}"
        }

